---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  align?: "left" | "center";
}
const { eyebrow, title, lede, align = "left" } = Astro.props;
---

<header class={`mb-10 lg:mb-14 ${align === "center" ? "text-center mx-auto max-w-2xl" : "max-w-2xl"}`}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-2 text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-[color:var(--color-text)]">
    {title}
  </h2>
  {lede && <p class="mt-4 text-base sm:text-lg text-[color:var(--color-text-muted)]">{lede}</p>}
</header>

    <div class="flex flex-col gap-1">
      <p class="text-sm text-[color:var(--color-text)] font-medium">David Lukić</p>
      <p class="text-xs text-[color:var(--color-text-dim)] font-mono">
        © {year} · Senior AI Engineer · Built with Astro + Tailwind
      </p>
    </div>

    <div class="flex items-center gap-3 text-sm text-[color:var(--color-text-muted)]">
      <a href="https://github.com/davidlukic99" target="_blank" rel="noopener" class="hover:text-[color:var(--color-text)] transition-colors">GitHub</a>
      <span class="text-[color:var(--color-text-dim)]">·</span>
      <a href="https://www.linkedin.com/in/davidlukic99/" target="_blank" rel="noopener" class="hover:text-[color:var(--color-text)] transition-colors">LinkedIn</a>
      <span class="text-[color:var(--color-text-dim)]">·</span>
      <a href="mailto:ldavid797@gmail.com" class="hover:text-[color:var(--color-text)] transition-colors">Email</a>

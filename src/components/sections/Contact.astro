---
import SectionHeader from "../ui/SectionHeader.astro";

const channels = [
  {
    label: "Book a call",
    value: "30 min via Calendly",
    href: "https://calendly.com/ldavid797/30min",
    icon: "calendar",
  },
  {
    label: "Email",
    value: "ldavid797@gmail.com",
    href: "mailto:ldavid797@gmail.com",
    icon: "mail",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/davidlukic99",
    href: "https://www.linkedin.com/in/davidlukic99/",
    icon: "linkedin",
  },
  {
    label: "GitHub",
    value: "github.com/davidlukic99",
    href: "https://github.com/davidlukic99",
    icon: "github",
  },
  {
    label: "Upwork",
    value: "Top Rated · 100% JSS",
    href: "https://www.upwork.com/freelancers/davidlukic99",
    icon: "upwork",
  },
];
---

<section id="contact" class="py-20 lg:py-28">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <SectionHeader eyebrow="// 06 · contact" title="Let's build something measurable." />

    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-6 lg:gap-10 items-start">
      <div class="card p-8 lg:p-10 relative overflow-hidden reveal">
        <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-[color:var(--color-accent)]/10 blur-3xl pointer-events-none"></div>

        <div class="relative">
          <p class="text-xl lg:text-2xl text-[color:var(--color-text)] leading-relaxed mb-6">
            If you're scaling AI infrastructure, shipping your first production LLM system, or just want to talk multi-agent design — I'd love to hear from you.
          </p>

          <div class="flex flex-wrap gap-3">
            <a href="https://calendly.com/ldavid797/30min" target="_blank" rel="noopener" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              Book a 30-min call
            </a>
            <a href="mailto:ldavid797@gmail.com" class="btn btn-secondary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              Email me
            </a>
            <a href="/David_Lukic.pdf" target="_blank" rel="noopener" class="btn btn-ghost">
              Download CV
            </a>
          </div>

          <div class="mt-8 pt-8 border-t border-[color:var(--color-border)]">
            <p class="font-mono text-xs text-[color:var(--color-text-dim)] mb-3">Also reachable at</p>
            <p class="font-mono text-sm text-[color:var(--color-text-muted)]">
              <span class="text-[color:var(--color-accent-2)]">$</span> curl davidlukic99.github.io
            </p>
          </div>
        </div>
      </div>

      <ul class="space-y-3 reveal" style="--reveal-delay: 120ms">
        {
          channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.href.startsWith("http") ? "_blank" : undefined}
                rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="group card p-5 flex items-center gap-4 transition-colors"
              >
                <span class="flex-shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-bg-elev)] text-[color:var(--color-text-muted)] group-hover:text-[color:var(--color-text)] group-hover:border-[color:var(--color-border-strong)] transition-colors">
                  {c.icon === "calendar" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  )}
                  {c.icon === "mail" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                  )}
                  {c.icon === "linkedin" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  )}
                  {c.icon === "github" && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                  )}
                  {c.icon === "upwork" && (
                    <svg width="20" height="20" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true"><path d="M493.9 359.6C443.6 359.6 410.4 320.7 401.1 305.7C413 210.4 447.9 180.3 493.9 180.3C539.4 180.3 574.8 216.7 574.8 270C574.8 323.3 539.4 359.7 493.9 359.7L493.9 359.6zM493.9 121.8C412 121.8 366.1 175.2 352.9 230.2C338 202.2 327 164.7 318.4 129.9L205.2 129.9L205.2 270.9C205.2 322 181.9 359.9 136.4 359.9C90.9 359.9 64.8 322.1 64.8 270.9L65.3 129.9L0 129.9L0 270.9C0 312 13.3 349.3 37.6 376C62.6 403.5 96.8 417.8 136.4 417.8C215.2 417.8 270.2 357.4 270.2 270.9L270.2 176.1C278.4 207.3 298 267.2 335.5 319.7L300.5 519.1L366.9 519.1L390 377.8C397.6 384.1 405.7 389.8 414.2 394.8C436.4 408.8 461.9 416.7 488.1 417.6C488.1 417.6 492.1 417.8 494.2 417.8C575.4 417.8 640.1 354.9 640.1 270C640.1 185.1 575.3 121.9 494.1 121.9L493.9 121.8z"/></svg>
                  )}
                </span>

                <div class="flex-1 min-w-0">
                  <p class="font-mono text-[11px] uppercase tracking-wider text-[color:var(--color-text-dim)]">{c.label}</p>
                  <p class="text-sm lg:text-[0.95rem] text-[color:var(--color-text)] truncate group-hover:text-[color:var(--color-accent-3)] transition-colors">
                    {c.value}
                  </p>
                </div>

                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[color:var(--color-text-dim)] group-hover:text-[color:var(--color-text)] transition-colors" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
